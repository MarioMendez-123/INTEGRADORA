# Entornos virtuales de Python (edge/.venv, backend/.venv)
.venv/

# Archivos temporales generados por Python
__pycache__/
*.pyc

# Logs locales (edge/logs/, backend/logs/) — no se suben a GitHub
logs/

# Logs de runtime del servidor de desarrollo (uvicorn) — se regeneran cada
# vez que se corre backend/main.py, no aportan nada útil en el historial
backend/server_stdout.log
backend/server_stderr.log

# Log local de pywhatkit (backend/frontend de terceros no relacionado con
# el proyecto) — puede contener números de teléfono y mensajes personales
# reales, nunca debe subirse a GitHub
PyWhatKit_DB.txt

# Output de prueba local del pipeline combinado de percepción (Observations
# en JSON) y de su agregación a Declared Inventory — no es código fuente, no
# se sube a GitHub
edge/perception/observations_output.json
edge/inventory_engine/declared_inventory_output.json

# Output de prueba local de edge/perception/test_detection_rate.py — registro
# crudo por objeto de una corrida manual de medición, no es código fuente
edge/perception/detection_rate_output.json

# Imágenes de marcadores ArUco generadas por
# edge/perception/generate_aruco_markers.py — archivos generados, no código
# fuente
edge/perception/aruco_markers/

# Base de datos local de desarrollo (SQLite) — no es código fuente
backend/aether.db

# Pesos de YOLOv8n descargados automáticamente por ultralytics en la
# primera corrida de cualquier script de percepción — no es código fuente,
# se regenera solo (ver docstring de edge/perception/test_yolo.py)
yolov8n.pt

# Dataset de piezas (fotos y etiquetas) y el peso entrenado. classes.txt
# sí se versiona; las imágenes no.
edge/perception/parts/images/
edge/perception/parts/labels/
edge/perception/parts/data.yaml
edge/perception/parts/lists/
edge/perception/weights/
edge/perception/runs/

# Variables de entorno / secretos (contraseñas, llaves)
.env
backend/spotify_token.json
backend/lumina_actions.jsonl
backend/lumina_memory.json
# Agenda de "Lumina, llama a <nombre>" (números personales)
backend/contactos.json

# Dependencias de Node.js (por si el dashboard usa JavaScript/React)
node_modules/
.arena/

# Skills locales del agente (fuentes y recetas, no son el producto)
.claude/skills/
.agents/skills/
SKILLS-DISENO-WEB.zip
lumina-agent.zip

# Audio/video de narración y render — superan el límite práctico de GitHub
AETHER_NARRACION.mp3
AETHER_NARRACION_trozos/
Lumina_Audio.mp3
Lumina_Audio.wav
lumina_audio/
Aether_Preview.mp4
Aether_Final.mp4
aether-video/node_modules/
aether-video/render/
aether-video/out/
aether-video/**/*.wav
aether-video/**/*.mp4

# Capturas sueltas y archivos basura
logo_frozen_frame*.png
docs/architecture/decisions/sdasd.py
