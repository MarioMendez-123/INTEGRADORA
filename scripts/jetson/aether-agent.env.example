# Configuracion del agente de percepcion del Jetson. Copia este archivo a ~/.aether-agent.env y edita.
#   cp ~/aether/scripts/jetson/aether-agent.env.example ~/.aether-agent.env
# Una variable por linea, sin comillas ni espacios alrededor del "=". NO pongas secretos aqui.
# Tabla completa de variables: docs/variables_entorno.md

# Direccion de la laptop (servidor). Sin ella el agente NO manda observaciones (solo sirve el video).
# Cambia la IP segun la red: 10.4.5.52 (WiFi Mecatronica), 192.168.100.14 (casa), 192.168.55.100 (USB-C).
# Tambien acepta un nombre (http://mi-laptop.local:8000), pero eso depende de que la red lo resuelva: prueba primero.
AETHER_LAPTOP_URL=http://10.4.5.52:8000

# Nombre de este equipo en las observaciones (minusculas, numeros, - y _).
AETHER_AGENT_ID=jetson

# Camara USB en Linux: V4L2, MJPG, 640x480 (lo que funciono en el Jetson).
PERCEPTION_CAMERA_BACKEND=v4l2
PERCEPTION_CAMERA_FOURCC=MJPG
PERCEPTION_CAMERA_WIDTH=640
PERCEPTION_CAMERA_HEIGHT=480

# Deteccion: maximo de inferencias por segundo (el video no espera a la deteccion).
AETHER_DETECT_MAX_HZ=10
